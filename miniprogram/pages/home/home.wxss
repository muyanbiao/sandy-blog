.hero {
  margin: 2rpx 0 30rpx;
  padding: 34rpx 30rpx 36rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.eyebrow {
  color: #2f7bcb;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 12rpx;
  color: #101827;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.05;
}

.subtitle {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
}

.section-subtitle {
  margin-top: 4rpx;
  color: #7b8798;
  font-size: 23rpx;
  font-weight: 700;
}

.loading {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 700;
}

.book-card {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 24rpx 70rpx 24rpx 24rpx;
  border: 2rpx solid #e3ebf6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.05);
}

.mark {
  flex: 0 0 auto;
  width: 12rpx;
  border-radius: 999rpx;
}

.class-accent {
  background: #2f7bcb;
}

.reading-accent {
  background: #f59e0b;
}

.book-main {
  min-width: 0;
}

.book-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
}

.book-subtitle {
  margin-top: 8rpx;
  color: #2f7bcb;
  font-size: 25rpx;
  font-weight: 900;
}

.book-desc {
  margin-top: 10rpx;
  color: #596579;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tags text {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #245f9f;
  font-size: 22rpx;
  font-weight: 900;
}

.arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  margin-top: -26rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #f1f6fd;
  color: #2f7bcb;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}
